# GEMINI_API_KEY: Required for default Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Alternative OpenAI API Key for OpenAI-powered evaluations
OPENAI_API_KEY=""

# Optional: Slack Incoming Webhook URL for instant SDR alerts (< 42s speed to lead)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK"

# Live HubSpot Private App Access Token for real CRM contact & deal creation
HUBSPOT_ACCESS_TOKEN="YOUR_HUBSPOT_ACCESS_TOKEN"
# PostgreSQL Database Connection String (asyncpg for Python / pg for Node)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_lead_analyzer"

# Redis Cache & Rate-Limiter URL
REDIS_URL="redis://localhost:6379/0"

# B2B Lead Enrichment Provider API Key (Apollo.io, Clearbit, or Proxycurl)
ENRICHMENT_API_KEY="your-apollo-or-clearbit-api-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional: Port for server hosting (default is 3000)
PORT=3000

# Optional: Generic external webhook URL (Zapier, Make, n8n)
WEBHOOK_URL=""

# Optional (for mobile apps / Capacitor builds): Public API domain where the server is hosted
VITE_API_BASE_URL=""

# Allowed CORS Origins (comma-separated domains)
ALLOWED_ORIGINS="https://yourdomain.com,https://app.yourdomain.com,http://localhost:3000,http://localhost:5173"
